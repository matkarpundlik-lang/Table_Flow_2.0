# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# SESSION_SIGNING_SECRET: HMAC signing secret for staff PIN, QR table sessions, and OTP proofs.
SESSION_SIGNING_SECRET=

# RAZORPAY_TEST_SECRET: Server-side secret for Razorpay test-mode payment signature verification.
RAZORPAY_TEST_SECRET=

# RAZORPAY_WEBHOOK_SECRET: Server-side secret for verifying incoming Razorpay webhooks.
RAZORPAY_WEBHOOK_SECRET=

# SMS OTP Provider (Configure Twilio OR an authenticated HTTPS OTP webhook; never simulate in production)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
OTP_WEBHOOK_URL=
OTP_WEBHOOK_SECRET=
